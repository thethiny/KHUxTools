# KHUx Tools — Environment Configuration
# Copy to .env and adjust for your setup.

# Phone ADB address
KHUX_PHONE=127.0.0.1:5555

# Florence-2 OCR endpoint
KHUX_FLORENCE_URL=http://localhost:17778/describe_base64

# Path to KHUx data directory (misc.mp4, m/, R/ etc.)
KHUX_DATA_DIR=/path/to/khux/data

# Path to this repo
KHUX_REPO_DIR=/path/to/KHUx
